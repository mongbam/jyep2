---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';

const plants = (await getCollection('plants')).sort((a, b) =>
  a.data.nameKo.localeCompare(b.data.nameKo, 'ko'),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '수초 재배 조건 데이터',
  description: '수초별 광량, CO2, 난이도, 심는 위치와 직접 잰 값을 정리한 데이터.',
  url: `${SITE.url}/plants/`,
  inLanguage: 'ko',
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: `${SITE.url}/api/plants.json`,
  },
};
---

<Base
  title="수초 데이터"
  description="수초별 광량, CO2, 난이도, 심는 위치를 한 표로 비교합니다."
  jsonLd={jsonLd}
>
  <h1>수초 데이터</h1>
  <p class="lead">
    수초 {plants.length}종의 재배 조건을 비교합니다. 이름을 누르면 상세 정보와 직접 잰 값을 볼 수 있습니다.
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>수초</th>
          <th>분류</th>
          <th>심는 위치</th>
          <th>광량</th>
          <th>CO2</th>
          <th>난이도</th>
          <th>성장</th>
        </tr>
      </thead>
      <tbody>
        {
          plants.map(({ data }) => (
            <tr>
              <td>
                <a href={`/plants/${data.id}/`}>{data.nameKo}</a>
              </td>
              <td>{data.type}</td>
              <td>{data.placement.join(', ')}</td>
              <td>{data.light}</td>
              <td>{data.co2}</td>
              <td>{data.difficulty}</td>
              <td>{data.growth}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="meta" style="margin-top:0.75rem">표는 옆으로 밀어서 볼 수 있습니다. 같은 데이터를 <a href="/api/plants.json">JSON</a>으로도 제공합니다.</p>
</Base>
