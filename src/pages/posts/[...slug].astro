---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SITE, COUPANG_DISCLOSURE, ADSENSE_SLOT_POST } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf() || a.id.localeCompare(b.id),
  );
  return posts.map((post, i) => {
    const link = (p?: (typeof posts)[number]) => (p ? { id: p.id, title: p.data.title } : undefined);
    return { params: { slug: post.id }, props: { post, prev: link(posts[i - 1]), next: link(posts[i + 1]) } };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, affiliate } = post.data;
const fmt = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long', timeZone: 'Asia/Seoul' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'ko',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<Base title={title} description={description} type="article" jsonLd={jsonLd}>
  <article>
    <h1>{title}</h1>
    <p class="meta">
      {fmt.format(pubDate)}
      {updatedDate && <> · 수정 {fmt.format(updatedDate)}</>}
    </p>
    {tags.length > 0 && <p>{tags.map((tag) => <span class="tag">{tag}</span>)}</p>}
    {affiliate && <p class="notice">{COUPANG_DISCLOSURE}</p>}
    <div class="prose">
      <Content />
    </div>
    <nav class="post-nav" aria-label="이전 글과 다음 글">
      {
        prev ? (
          <a class="post-nav-link" href={`/posts/${prev.id}/`} rel="prev">
            <span class="post-nav-label">← 이전 글</span>
            <span class="post-nav-title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="post-nav-link next" href={`/posts/${next.id}/`} rel="next">
            <span class="post-nav-label">다음 글 →</span>
            <span class="post-nav-title">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
    <p class="post-nav-all"><a href="/posts/">글 목록 전체 보기</a></p>
    <AdSlot slot={ADSENSE_SLOT_POST} />
  </article>
</Base>
