---
// 애드센스 광고 자리. PUBLIC_ADSENSE_CLIENT 환경 변수가 없으면 아무것도 그리지 않는다.
import { ADSENSE_CLIENT } from '../consts';

interface Props {
  slot: string;
}

const { slot } = Astro.props;
---

{
  ADSENSE_CLIENT && (
    <div class="ad-slot">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  )
}
